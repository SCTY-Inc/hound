{
  "schema_version": "hound.driver.v1",
  "id": "config-migration",
  "protocol": "hound.protocol.v1",
  "owner": {
    "repo": "."
  },
  "exec": [
    "python3",
    "driver.py"
  ],
  "capabilities": {
    "config.inspect": {
      "effect": "read",
      "gate": "none"
    },
    "config.migrate": {
      "effect": "write",
      "gate": "human"
    }
  },
  "run_root": ".hound/runs",
  "write_scopes": [
    "config.json"
  ],
  "timeouts_seconds": {
    "default": 10
  },
  "env_allowlist": []
}
