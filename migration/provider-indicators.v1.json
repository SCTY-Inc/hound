    {"id":"youtube-skill","category":"prompt_skill_acquisition","provider":"youtube","match":{"kind":"literal","value":"direct transcription skill"}},
    {"id":"exa-http-transport","category":"outbound_transport","provider":"exa","match":{"kind":"literal","value":"requests."}},
