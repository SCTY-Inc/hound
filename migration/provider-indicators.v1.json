    {"id":"deepgram-endpoint","category":"endpoint","provider":"deepgram","match":{"kind":"literal","value":"api.deepgram.com"}},
    {"id":"exa-sdk","category":"sdk_import","provider":"exa","match":{"kind":"token","value":"exa_py"}},
