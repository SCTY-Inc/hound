# Hound discovery read service (user unit).
#
# Always-on by design: houndd owns its socket bind (an atomic no-replace
# publish that refuses pre-created files), so systemd fd-passing socket
# activation cannot work without a houndd source change, and the trigger-
# only approximation drops the first cold-start connection — unacceptable
# for consumers that fail closed instead of retrying. See README.md.

[Unit]
Description=Hound discovery read service
Documentation=file:%h/repos/hound/ops/systemd/README.md

[Service]
Type=simple
EnvironmentFile=%h/.config/hound/houndd.env
# %S is the state ROOT (~/.local/state) — StateDirectory=hound only exempts
# the subdir and sets $STATE_DIRECTORY; it does not graft "hound/" into %S.
# The subdir must appear literally here, exactly as %t/hound/ does below.
ExecStart=%h/.local/bin/houndd serve --state %S/hound/discovery --socket %t/hound/houndd.sock

Restart=on-failure
RestartSec=1

StateDirectory=hound
StateDirectoryMode=0700
RuntimeDirectory=hound
RuntimeDirectoryMode=0700

# Explicit memory ceiling — every service on this host gets one (see the
# operator's host CLAUDE.md, Resources section). Matches the hand-managed
# unit's memory.conf drop-in. Raised from 384M/512M 2026-08-05: measured
# peak footprint (cgroup memory.peak) never exceeded ~80M RSS + ~42M swap
# even at oomd-kill time, so the kills were not houndd hitting its own cap
# — this raise gives real headroom in case working set grows, but the root
# driver was host-wide app.slice swap pressure (see task #3 report).
MemoryHigh=768M
MemoryMax=1G

# Sandboxing. ProtectHome=read-only would make ~/.local/state (where
# houndd's journal/store/policy live) unwritable outright; StateDirectory=
# and RuntimeDirectory= above are explicitly exempted from ProtectHome/
# ProtectSystem (systemd.exec(5): "these options imply BindPaths="), so the
# service gets a read-only view of the rest of $HOME plus a writable state
# dir, with no broader carve-out needed.
NoNewPrivileges=yes
ProtectHome=read-only
ProtectSystem=strict
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# houndd hosts live adapters (Exa, Firecrawl) that make outbound HTTPS
# requests, so network address families stay open; only the socket family
# is otherwise needed for the UDS read path itself.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
